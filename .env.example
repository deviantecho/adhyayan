# Adhyayan Environment Configuration
# Copy this file to .env and configure your settings

# ==================================================
# LLM Provider Selection
# ==================================================
# Set to "gemini" for production or "omniroute" for local development
LLM_PROVIDER=gemini

# ==================================================
# Gemini Configuration (Production)
# ==================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ==================================================
# OmniRoute Configuration (Local Development)
# ==================================================
# OmniRoute runs locally and provides OpenAI-compatible API
# Default: http://127.0.0.1:20128/v1
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# API key (often not required for local OmniRoute)
OMNIROUTE_API_KEY=

# Model identifier configured in OmniRoute
# This must match a model available in your OmniRoute instance
OMNIROUTE_MODEL=your_model_name_here

# ==================================================
# Frontend URL (Production)
# ==================================================
# Production frontend origin for CORS (e.g., https://adhyayan.vercel.app)
FRONTEND_URL=

# ==================================================
# Debug Settings (Optional)
# ==================================================
# Enable detailed timing logs for development
# Set to "true" for local development, "false" for production
DEBUG_TIMING=false
